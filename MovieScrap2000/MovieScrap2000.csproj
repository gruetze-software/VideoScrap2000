<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>VideoScrap2000</AssemblyName>
    <Product>VideoScrap 2000</Product>
    <ApplicationIcon>Assets/videoscrap-2000.ico</ApplicationIcon>
    <Company>Grütze-Software</Company>
    <Version>1.3.0</Version>
    <Copyright>© 2026 Grütze-Software</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Avalonia's XAML compiler uses symbols during compilation. Publish removes
         them from the deliverable below, including symbols from dependencies. -->
    <DebugType>portable</DebugType><DebugSymbols>true</DebugSymbols>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VideoScrap2000.Tests" />
    <InternalsVisibleTo Include="VideoScrap2000.DisplaySmoke" />
    <Compile Remove="Properties/**/*.cs" />
    <EmbeddedResource Remove="Properties/**/*.resx" />
    <AvaloniaResource Include="Assets/**" Exclude="Assets/*.ico" />
    <EmbeddedResource Include="Localization/en.json" LogicalName="VideoScrap2000.Localization.en.json" />
    <ProjectReference Include="../VideoScrap2000.Core/VideoScrap2000.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" Condition="'$(RuntimeIdentifier)' == ''" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.4" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <PackageReference Include="Avalonia.X11" Version="12.1.4" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" Condition="'$(RuntimeIdentifier)' == '' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
    <PackageReference Include="Avalonia.Native" Version="12.1.4" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"><DefineConstants>$(DefineConstants);TARGET_WINDOWS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))"><DefineConstants>$(DefineConstants);TARGET_LINUX</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))"><DefineConstants>$(DefineConstants);TARGET_MACOS</DefineConstants></PropertyGroup>
  <Target Name="RemoveReleaseSymbols" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.dbg' Or '%(Extension)' == '.debug' Or '%(Extension)' == '.lib' Or '%(Extension)' == '.exp' Or '%(Extension)' == '.a' Or $([System.String]::Copy('%(RelativePath)').Contains('.dSYM'))" />
    </ItemGroup>
  </Target>
</Project>
