<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VideoScrap2000.Views.AboutWindow"
        Title="{DynamicResource L1DA77F05579C}" Icon="/Assets/videoscrap-2000.png" Width="600" Height="680" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="28">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="22,0,22,4">
        <Image Source="/Assets/videoscrap-2000.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="96" Height="96" HorizontalAlignment="Center"/>
        <TextBlock Text="VideoScrap 2000" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Classes="secondary" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource LFC451D627D21}" FontSize="16" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource LE1489F7ADC70}" TextWrapping="Wrap" TextAlignment="Center" Classes="secondary"/>
        <Separator Margin="0,6"/>
        <Grid ColumnDefinitions="100,*" Margin="12,0">
          <Image Source="/Assets/gruetze-software.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="100" Height="100"/>
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Text="{DynamicResource L828AB4AE1D7A}" FontSize="12" Classes="secondary"/>
            <TextBlock Text="Grütze-Software" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="© 2026 Grütze-Software" FontSize="12" Classes="secondary"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6">
          <Button Content="{DynamicResource L40EBF93AF8D4}" Click="OpenProject"/>
          <Button Content="Grütze-Software" Click="OpenManufacturer"/>
        </StackPanel>
        <Separator/>
        <TextBlock Text="{DynamicResource L243ED6E06F9E}" TextWrapping="Wrap" TextAlignment="Center"/>
        <Button Content="{DynamicResource L2B81499871E7}" Click="OpenKofi" Classes="primary" HorizontalAlignment="Center"/>
        <Separator/>
        <TextBlock Text="{DynamicResource LC28E8BFD923B}" FontWeight="SemiBold" TextAlignment="Center"/>
        <WrapPanel HorizontalAlignment="Center">
          <Button Click="OpenTmdb" AutomationProperties.Name="TMDB" Margin="0,0,8,0">
            <Path Width="104" Height="14" Stretch="Uniform" Data="M191.85,35.37h63.9A17.67,17.67,0,0,0,273.42,17.7h0A17.67,17.67,0,0,0,255.75,0h-63.9A17.67,17.67,0,0,0,174.18,17.7h0A17.67,17.67,0,0,0,191.85,35.37ZM10.1,35.42h7.8V6.92H28V0H0v6.9H10.1Zm28.1,0H46V8.25h.1L55.05,35.4h6L70.3,8.25h.1V35.4h7.8V0H66.45l-8.2,23.1h-.1L50,0H38.2ZM89.14.12h11.7a33.56,33.56,0,0,1,8.08,1,18.52,18.52,0,0,1,6.67,3.08,15.09,15.09,0,0,1,4.53,5.52,18.5,18.5,0,0,1,1.67,8.25,16.91,16.91,0,0,1-1.62,7.58,16.3,16.3,0,0,1-4.38,5.5,19.24,19.24,0,0,1-6.35,3.37,24.53,24.53,0,0,1-7.55,1.15H89.14Zm7.8,28.2h4a21.66,21.66,0,0,0,5-.55A10.58,10.58,0,0,0,110,26a8.73,8.73,0,0,0,2.68-3.35,11.9,11.9,0,0,0,1-5.08,9.87,9.87,0,0,0-1-4.52,9.17,9.17,0,0,0-2.63-3.18A11.61,11.61,0,0,0,106.22,8a17.06,17.06,0,0,0-4.68-.63h-4.6ZM133.09.12h13.2a32.87,32.87,0,0,1,4.63.33,12.66,12.66,0,0,1,4.17,1.3,7.94,7.94,0,0,1,3,2.72,8.34,8.34,0,0,1,1.15,4.65,7.48,7.48,0,0,1-1.67,5,9.13,9.13,0,0,1-4.43,2.82V17a10.28,10.28,0,0,1,3.18,1,8.51,8.51,0,0,1,2.45,1.85,7.79,7.79,0,0,1,1.57,2.62,9.16,9.16,0,0,1,.55,3.2,8.52,8.52,0,0,1-1.2,4.68,9.32,9.32,0,0,1-3.1,3A13.38,13.38,0,0,1,152.32,35a22.5,22.5,0,0,1-4.73.5h-14.5Zm7.8,14.15h5.65a7.65,7.65,0,0,0,1.78-.2,4.78,4.78,0,0,0,1.57-.65,3.43,3.43,0,0,0,1.13-1.2,3.63,3.63,0,0,0,.42-1.8A3.3,3.3,0,0,0,151,8.6a3.42,3.42,0,0,0-1.23-1.13A6.07,6.07,0,0,0,148,6.9a9.9,9.9,0,0,0-1.85-.18h-5.3Zm0,14.65h7a8.27,8.27,0,0,0,1.83-.2,4.67,4.67,0,0,0,1.67-.7,3.93,3.93,0,0,0,1.23-1.3,3.8,3.8,0,0,0,.47-1.95,3.16,3.16,0,0,0-.62-2,4,4,0,0,0-1.58-1.18,8.23,8.23,0,0,0-2-.55,15.12,15.12,0,0,0-2.05-.15h-5.9Z">
              <Path.Fill><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Offset="0" Color="#90CEA1"/><GradientStop Offset="0.56" Color="#3CBEC9"/><GradientStop Offset="1" Color="#00B3E5"/></LinearGradientBrush></Path.Fill>
            </Path>
          </Button>
          <Button Content="Fanart.tv" Click="OpenFanart"/>
          <Button Content="TVmaze" Click="OpenTvmaze" Margin="8,0,0,0"/>
        </WrapPanel>
        <TextBlock Text="{DynamicResource LF30225D2A447}" TextWrapping="Wrap" TextAlignment="Center" Classes="secondary"/>
        <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." TextWrapping="Wrap" TextAlignment="Center" Classes="secondary" FontSize="12"/>
        <Separator/>
        <TextBlock Text="C# · .NET 10 · Avalonia 12.1.4" Classes="secondary" TextAlignment="Center" FontSize="12"/>
        <TextBlock Text="{DynamicResource L51AD104321A0}" Classes="secondary" TextAlignment="Center" FontSize="12"/>
        <TextBlock Text="{DynamicResource L7590A830FEA2}" TextWrapping="Wrap" TextAlignment="Center" Classes="secondary" FontSize="11"/>
        <TextBlock x:Name="LinkStatus" TextWrapping="Wrap" Classes="secondary" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="{DynamicResource LB808F6E97075}" Click="CloseWindow" IsDefault="True" IsCancel="True" HorizontalAlignment="Center" MinWidth="120" Margin="0,18,0,0"/>
  </Grid>
</Window>
