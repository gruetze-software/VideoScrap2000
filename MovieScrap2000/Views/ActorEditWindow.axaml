<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VideoScrap2000.ViewModels" xmlns:views="using:VideoScrap2000.Views"
        x:Class="VideoScrap2000.Views.ActorEditWindow" x:DataType="vm:ActorEditor" Title="{DynamicResource L425D57FA4B15}" Width="540" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <Grid ColumnDefinitions="*,168" ColumnSpacing="24">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource LDCD1D5223F73}" Classes="label"/>
          <TextBox Text="{Binding Name}"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource L0038A9CF8661}" Classes="label"/>
          <TextBox Text="{Binding Role}"/>
        </StackPanel>
        <StackPanel Spacing="4" HorizontalAlignment="Left">
          <TextBlock Text="TMDB ID" Classes="label"/>
          <NumericUpDown Value="{Binding TmdbId}" Minimum="0" FormatString="0" Width="148"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" ClipToBounds="True">
          <Grid>
            <views:MoviePosterThumbnail x:Name="Portrait" Height="156" DecodeWidth="240" Stretch="Uniform"/>
            <TextBlock x:CompileBindings="False" Text="{Binding #Portrait.Resolution}"
                       IsVisible="{Binding #Portrait.Resolution, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Background="#B0000000" Foreground="White" FontSize="11" Padding="4,2"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <Button x:Name="ChoosePhotoButton" Click="ChoosePhoto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button x:Name="SearchPhotoButton" Click="SearchPhoto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="PhotoStatus" x:CompileBindings="False" Classes="secondary" TextWrapping="Wrap"
               IsVisible="{Binding #PhotoStatus.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{DynamicResource LF7FF1178AF20}" Click="Cancel" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="{DynamicResource LF6B2FF39F540}" Click="Save" IsDefault="True" Classes="primary"/>
    </StackPanel>
  </StackPanel>
</Window>
