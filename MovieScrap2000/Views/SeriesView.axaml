<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VideoScrap2000.ViewModels" xmlns:views="using:VideoScrap2000.Views"
             x:Class="VideoScrap2000.Views.SeriesView" x:DataType="vm:SeriesViewModel">
  <Grid ColumnDefinitions="310,16,*" Margin="0,10,0,0">
    <Border Classes="card" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <TextBox Text="{Binding Query, Delay=250}" PlaceholderText="{DynamicResource L7D481B656493}"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Shows}" SelectedItem="{Binding SelectedShow}" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SeriesShowRow">
              <Grid ColumnDefinitions="42,10,*" Margin="4,7" ToolTip.Tip="{Binding Show.FolderPath}">
                <Border Height="63" Classes="card" ClipToBounds="True"><views:MoviePosterThumbnail DataContext="{Binding Poster}" Stretch="UniformToFill"/></Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Editor.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Classes.missing="{Binding !Editor.HasNfo}"/>
                  <TextBlock Text="{Binding Editor.Date}" Classes="secondary" FontSize="12"/>
                  <TextBlock Text="{Binding Episodes.Count, StringFormat={}{0}}" Classes="secondary" FontSize="12" ToolTip.Tip="{DynamicResource LF859BE901B60}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Border Grid.Column="2" Classes="card" Padding="20" IsVisible="{Binding !SelectedShow}">
      <TextBlock Text="{DynamicResource L9290FD1CF9E4}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Border>
    <Border Grid.Column="2" Classes="card" Padding="16" IsVisible="{Binding !!SelectedShow}" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.RowSpan="3" Margin="-16" IsVisible="{Binding UseFanartBackground}" IsHitTestVisible="False">
          <views:MoviePosterThumbnail DataContext="{Binding BackgroundPreview}" DecodeWidth="960"
                                      Stretch="UniformToFill" Opacity="0.20"/>
        </Border>
        <TextBlock Text="{Binding ShowEditor.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,4,10"/>
        <Border Grid.Row="1" IsVisible="{Binding !!SeasonBannerPreview}" CornerRadius="6"
                ClipToBounds="True" Margin="4,0,4,12" MaxHeight="160">
          <views:MoviePosterThumbnail x:Name="SeasonBanner" DataContext="{Binding SeasonBannerPreview}"
                                      DecodeWidth="1800" AspectRatio="5.4" MaxHeight="160" Stretch="Uniform"
                                      DoubleTapped="OpenPicture" ToolTip.Tip="{DynamicResource LF9C2CE9BEE55}"/>
        </Border>
        <TabControl Grid.Row="2" x:Name="SeriesDetailTabs" Classes="seriesTabs" SelectedIndex="{Binding DetailTabIndex, Mode=TwoWay}">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,6,8"/>
              <Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            </Style>
            <Style Selector="TabItem:selected">
              <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource PageBrush}"/>
            </Style>
          </TabControl.Styles>
          <TabItem Header="{DynamicResource LFF7164F80BE8}">
            <Grid RowDefinitions="*,Auto">
              <ScrollViewer>
                <StackPanel Margin="8,6,12,12" Spacing="2">
                  <Grid ColumnDefinitions="*,12,*"><StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource L652095EFC4C7}" Classes="label"/><TextBox Text="{Binding ShowEditor.Title}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource LD92244697AF0}" Classes="label"/><TextBox Text="{Binding ShowEditor.OriginalTitle}"/></StackPanel></Grid>
                  <Grid ColumnDefinitions="*,12,*"><StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource L7662F7DDB9D6}" Classes="label"/><TextBox Text="{Binding ShowEditor.Date}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L4C0188E41ECD}" Classes="label"/><TextBox Text="{Binding ShowEditor.Status}"/></StackPanel></Grid>
                  <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                    <StackPanel><TextBlock Text="{DynamicResource L6AAA60B94AF9}" Classes="label"/><TextBox Text="{Binding ShowEditor.ImdbId}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L9A9E55D41F32}" Classes="label"/><TextBox Text="{Binding ShowEditor.TmdbId}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource L63530CEB12E6}" Classes="label"/><TextBox Text="{Binding ShowEditor.TvdbId}"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="{DynamicResource LEE1AD0C07BF2}" Classes="label"/><TextBox Text="{Binding ShowEditor.Certification}"/></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel><TextBlock Text="{DynamicResource L3561ABFE8067}" Classes="label"/><TextBox Text="{Binding ShowEditor.Genres}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L9564EAD4C35A}" Classes="label"/><TextBox Text="{Binding ShowEditor.Studios}"/></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel><TextBlock Text="{DynamicResource L0DB6193FEC07}" Classes="label"/><TextBox Text="{Binding ShowEditor.Countries}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource LBE2382585699}" Classes="label"/><TextBox Text="{Binding ShowEditor.Tags}"/></StackPanel>
                  </Grid>
                  <TextBlock Text="{DynamicResource L5C9FECD4DF0A}" Classes="label"/>
                  <TextBox Text="{Binding ShowEditor.Plot}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"/>
                </StackPanel>
              </ScrollViewer>
              <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource LF5009A6C802B}" Click="SearchShow" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource L6C86B99088D0}" Command="{Binding SaveShowCommand}" Classes="primary"/>
              </WrapPanel>
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource L425D57FA4B15}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="6,8,0,0">
              <Button Content="{DynamicResource LCBB95CF02B7D}" Click="AddActor" HorizontalAlignment="Left" Margin="0,0,0,8"/>
              <Grid Grid.Row="1" ColumnDefinitions="*,12,120">
                <Border Classes="card" ClipToBounds="True">
                  <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource SubtleBrush}" Padding="8">
                      <Grid ColumnDefinitions="2*,2*,72,28">
                        <TextBlock Text="{DynamicResource LDCD1D5223F73}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource L0038A9CF8661}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="ID" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="SeriesCast" ItemsSource="{Binding ShowEditor.Actors}" SelectedItem="{Binding SelectedActor}"
                             SelectionMode="Multiple" KeyDown="ActorKeyDown" Background="Transparent" BorderThickness="0">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActorEditor">
                          <Grid ColumnDefinitions="2*,2*,72,28" Margin="8,3" Background="Transparent" DoubleTapped="OpenActorPicture">
                            <Grid.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource L84E45EE73411}" Click="EditActor"/></ContextMenu></Grid.ContextMenu>
                            <TextBlock Text="{Binding Name}" Classes.actorWithoutPicture="{Binding HasNoPicture}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Role}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Role}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding TmdbId}" Classes="secondary" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="×" Click="RemoveActor" Padding="0" Width="24" Height="24" Background="Transparent" ToolTip.Tip="{DynamicResource L3828375A2D45}"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SubtleBrush}" CornerRadius="8" Height="180" ClipToBounds="True" VerticalAlignment="Top">
                  <views:MoviePosterThumbnail x:Name="SeriesActorPhoto" DataContext="{Binding ActorPreview}" DecodeWidth="240"
                                              Stretch="Uniform" DoubleTapped="OpenPicture" ToolTip.Tip="{DynamicResource LF9C2CE9BEE55}"/>
                </Border>
              </Grid>
              <Button Grid.Row="2" Content="{DynamicResource L6C86B99088D0}" Command="{Binding SaveShowCommand}"
                      Classes="primary" HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource LF859BE901B60}">
            <Grid ColumnDefinitions="200,12,*" Margin="6,8,0,0">
              <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="8">
                  <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SeriesSeason"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <ListBox x:Name="EpisodeList" Grid.Row="1" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}" Margin="0,8">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesEpisodeRow">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Editor.Title}" TextWrapping="Wrap" Classes.missing="{Binding !Editor.HasNfo}"/>
                        <TextBlock Text="{Binding Editor.EpisodeCode}" FontSize="12" Classes="secondary"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Spacing="6">
                  <Button Content="{DynamicResource L863E9B2AE2F8}" Click="AddEpisode" HorizontalAlignment="Stretch"/>
                  <Button Content="{DynamicResource L9F5078A12895}" Command="{Binding FindAllEpisodesCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="EpisodeEmptyHint" Grid.Column="2" Text="{DynamicResource L45C35309501C}" IsVisible="{Binding !HasSelectedEpisode}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Grid Grid.Column="2" RowDefinitions="*,Auto" IsVisible="{Binding HasSelectedEpisode}">
                <ScrollViewer>
                  <StackPanel Margin="0,0,8,12" Spacing="2">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                      <Border IsVisible="{Binding !!SeasonPosterPreview}" Width="120" Height="180"
                              CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top">
                        <views:MoviePosterThumbnail x:Name="EpisodeSeasonPoster" DataContext="{Binding SeasonPosterPreview}"
                                                    DecodeWidth="360" Stretch="Uniform" DoubleTapped="OpenPicture"
                                                    ToolTip.Tip="{DynamicResource LF9C2CE9BEE55}"/>
                      </Border>
                      <Border Grid.Column="1" IsVisible="{Binding !!EpisodePicture}" Height="180"
                              CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <views:MoviePosterThumbnail x:Name="EpisodeStill" DataContext="{Binding EpisodePicture}"
                                                    DecodeWidth="720" Height="180" HorizontalAlignment="Left"
                                                    Stretch="Uniform" DoubleTapped="OpenPicture"
                                                    ToolTip.Tip="{DynamicResource LF9C2CE9BEE55}"/>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="3*,12,*,12,*">
                      <StackPanel><TextBlock Text="{DynamicResource L5998202DB544}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Title}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource LCFFE8F197E4B}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Season}"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource LF772FB34DF8C}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Episode}"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*,12,*">
                      <StackPanel><TextBlock Text="{DynamicResource L7662F7DDB9D6}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Date}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L239B620FD67A}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Runtime}"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource L9A9E55D41F32}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.TmdbId}"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                      <StackPanel><TextBlock Text="{DynamicResource L98C628646F7C}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Directors}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L86D105545374}" Classes="label"/><TextBox Text="{Binding EpisodeEditor.Writers}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource L5C9FECD4DF0A}" Classes="label"/>
                    <TextBox Text="{Binding EpisodeEditor.Plot}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                    <TextBlock Text="{Binding SelectedEpisodePath}" Classes="secondary" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button Content="{DynamicResource L52D3CE956EE4}" Click="SearchEpisode" Margin="0,0,6,0"/>
                  <Button Content="{DynamicResource L6C86B99088D0}" Command="{Binding SaveEpisodeCommand}" Classes="primary"/>
                </WrapPanel>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource LD5FBB86ADD39}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="6,8,0,0">
              <WrapPanel Margin="0,0,0,12">
                <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" MinWidth="160" Margin="0,0,8,0" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SeriesSeason"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding SeriesArtworkTypes}" SelectedItem="{Binding ArtworkSearchType}" MinWidth="150" Margin="0,0,8,0" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource Translate}}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{DynamicResource L38B0391AE790}" Click="SearchArtwork" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock Grid.Row="1" Text="{Binding ArtworkSourceWarning}" TextWrapping="Wrap" Classes="secondary" Margin="0,0,0,8"/>
              <ListBox Grid.Row="2" x:Name="SeriesArtworkList" ItemsSource="{Binding ArtworkTiles}" SelectedItem="{Binding SelectedSeriesArtwork}"
                       Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="Transparent"/></Style>
                    <Style Selector="ListBoxItem:selected Border.card"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3"/></Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesArtworkTile">
                      <Border Classes="card" Width="200" Padding="8">
                        <StackPanel Spacing="6">
                          <views:MoviePosterThumbnail DataContext="{Binding Picture}" DecodeWidth="400" Height="112"
                                                      Stretch="Uniform" DoubleTapped="OpenPicture" ToolTip.Tip="{DynamicResource LF9C2CE9BEE55}"/>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource L6C86B99088D0}" Command="{Binding SaveShowCommand}" Classes="primary"/>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
