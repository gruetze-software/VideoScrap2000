<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'"><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols></PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(FANART_TV_PROJECT_API_KEY)', '^[0-9a-fA-F]{32}$'))">
    <AssemblyMetadata Include="FanartTvProjectApiKey" Value="$(FANART_TV_PROJECT_API_KEY)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MediaInfo.Wrapper.Core" Version="26.10.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <EmbeddedResource Include="Resources/Empty.png" LogicalName="VideoScrap2000.Empty.png" />
  </ItemGroup>
</Project>
